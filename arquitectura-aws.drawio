<mxCell id="autoscaling" value="&lt;b&gt;Application Auto Scaling&lt;/b&gt;&lt;br&gt;api: CPU 60 % (2 a 4)&lt;br&gt;worker: 10 mensajes por tarea (1 a 4)&lt;br&gt;procesador: 50 mensajes por tarea (1 a 2)&lt;br&gt;evaluador: escalones 0 ↔ 1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_auto_scaling;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="ops"><mxGeometry x="586" y="50" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="alarmas" value="&lt;b&gt;CloudWatch · alarmas&lt;/b&gt;&lt;br&gt;ateneo-{inferencias,evaluaciones,resultados}-con-fallidos&lt;br&gt;ateneo-alb-5xx (5 o más en 5 min)&lt;br&gt;ateneo-evaluador-crecer · ateneo-evaluador-achicar" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="ops"><mxGeometry x="1026" y="50" width="48" height="48" as="geometry"/></mxCell>
