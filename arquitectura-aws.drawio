<mxCell id="logs" value="&lt;b&gt;CloudWatch Logs · retención 7 días&lt;/b&gt;&lt;br&gt;/ecs/ateneo/{api,procesador,worker,evaluador}&lt;br&gt;/aws/apigateway/ateneo&lt;br&gt;/aws/lambda/ateneo-callback&lt;br&gt;/aws/lambda/ateneo-post-confirmacion" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="ops"><mxGeometry x="1726" y="50" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="leyenda" value='&lt;div style="font-weight:bold;font-size:13px;"&gt;Referencias&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1950" width="520" height="30" as="geometry"/></mxCell>
<mxCell id="leg_t0" value="Pedido de usuario desde internet" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="142" y="1982" width="410" height="18" as="geometry"/></mxCell>
<mxCell id="leg_t1" value="Tráfico dentro de la VPC (puerto en la etiqueta)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="142" y="2008" width="410" height="18" as="geometry"/></mxCell>
<mxCell id="leg_t2" value="Salida a servicios de AWS o a internet (endpoints, NAT)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="142" y="2034" width="410" height="18" as="geometry"/></mxCell>
